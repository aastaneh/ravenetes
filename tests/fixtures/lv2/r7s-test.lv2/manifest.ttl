@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<urn:r7s:test:amp>
    a lv2:Plugin ;
    lv2:binary <amp.so> ;
    rdfs:seeAlso <amp.ttl> .

<urn:r7s:test:synth>
    a lv2:Plugin ;
    lv2:binary <synth.so> ;
    rdfs:seeAlso <synth.ttl> .

<urn:r7s:test:amp#ui>
    a ui:X11UI ;
    ui:binary <amp_ui.so> ;
    rdfs:seeAlso <does-not-exist-ui.ttl> .

<urn:r7s:test:amp#preset1>
    a pset:Preset ;
    lv2:appliesTo <urn:r7s:test:amp> ;
    rdfs:seeAlso <broken-preset.ttl> .

<urn:r7s:test:amp#clean>
    a pset:Preset ;
    lv2:appliesTo <urn:r7s:test:amp> ;
    rdfs:label "Clean" ;
    rdfs:seeAlso <amp-presets.ttl> .
