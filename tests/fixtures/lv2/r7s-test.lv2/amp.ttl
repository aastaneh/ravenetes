@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<urn:r7s:test:amp>
    a lv2:AmplifierPlugin, lv2:Plugin ;
    doap:name "R7S Test Amp" ;
    ui:ui <urn:r7s:test:amp#ui> ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 0.0 ; lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:db
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "mode" ; lv2:name "Mode" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Clean" ; rdf:value 0 ] ,
                       [ rdfs:label "Crunch" ; rdf:value 1 ] ,
                       [ rdfs:label "Lead" ; rdf:value 2 ]
    ] , [
        a lv2:OutputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "level" ; lv2:name "Level"
    ] .
